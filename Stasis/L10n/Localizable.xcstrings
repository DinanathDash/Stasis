    "Pause charging when the battery temperature exceeds the threshold.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden pausieren, wenn die Batterietemperatur den Schwellenwert überschreitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar la carga cuando la temperatura de la batería supere el umbral."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar la carga cuando la temperatura de la batería supere el umbral."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー温度がしきい値を超えた場合は、充電を一時停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当电池温度超过阈值时暂停充电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當電池溫度超過閾值時暫停充電。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановите зарядку, когда температура батареи превысит пороговое значение."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeer het opladen wanneer de batterijtemperatuur de drempelwaarde overschrijdt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil sıcaklığı eşiği aştığında şarjı duraklatın."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaustavite polnjenje, ko temperatura baterije preseže prag."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastavte nabíjanie, keď teplota batérie prekročí prahovú hodnotu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng sạc khi nhiệt độ pin vượt quá ngưỡng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 온도가 임계값을 초과하면 충전을 일시 중지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre la charge en pause lorsque la température dépasse le seuil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sospendere la ricarica quando la temperatura della batteria supera la soglia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar o carregamento quando a temperatura da bateria exceder o limiar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar o carregamento quando a temperatura da bateria exceder o limiar."
          }
        }
      }
    },
    "Percentage drop allowed before recharging in Sailing Mode (1 to 20)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zulässiger prozentualer Abfall vor dem Aufladen im Segel-Modus (1 bis 20)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caída permitida antes de recargar en modo navegación (1 a 20)"
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Caída permitida antes de recargar en modo navegación (1 a 20)"
          }
        },
        "fr": {
