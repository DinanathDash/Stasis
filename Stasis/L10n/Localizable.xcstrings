    "Discharge the battery to your charge limit when plugged in above the target level.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterie bis zum Ladelimit entladen, wenn oberhalb des Ziels angeschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar la batería hasta tu límite de carga cuando esté conectada por encima del nivel objetivo."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar la batería hasta tu límite de carga cuando esté conectada por encima del nivel objetivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標レベルを超えて接続されている場合は、充電限界までバッテリーを放電してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接通电源且电量高于目标值时，将电池放电至充电上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當插入電池時，將電池放電至高於目標電量的充電限制。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрядите аккумулятор до предела заряда, если он подключен к сети выше целевого уровня."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontlaad de batterij tot uw laadlimiet wanneer de stekker boven het doelniveau ligt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pili hedef seviyenin üzerinde taktığınızda şarj sınırınıza kadar boşaltın."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izpraznite baterijo do meje napolnjenosti, ko jo priključite nad ciljno raven."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď je batéria zapojená nad cieľovú úroveň, vybite ju na limit nabitia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xả pin đến giới hạn sạc của bạn khi cắm điện trên mức mục tiêu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 수준 이상으로 연결되면 배터리를 충전 한도까지 방전하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décharger la batterie jusqu'à la limite de charge lorsqu'elle est branchée au-dessus du niveau cible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica la batteria fino al limite di carica quando è collegata a un livello superiore al livello target."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarregar a bateria até ao limite de carga quando ligada à corrente acima do nível pretendido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarregar a bateria até ao limite de carga quando ligada à energia acima do nível pretendido."
          }
        }
      }
    },
