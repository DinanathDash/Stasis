    "Enable or disable Sailing Mode (allow battery to discharge naturally before recharging).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert oder deaktiviert den Segelmodus (natürliche Entladung vor erneutem Laden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva el Modo Navegación (permite que la batería se descargue naturalmente antes de recargar)."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva el Modo Navegación (permite que la batería se descargue naturalmente antes de recargar)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive le mode Navigation (laisse la batterie se décharger naturellement avant de recharger)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva la Modalità Navigazione (lascia scaricare la batteria prima della ricarica)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーリングモードを有効または無効にします（再充電前に自然に放電）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세일링 모드를 활성화 또는 비활성화합니다(재충전 전 자연 방전 허용)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt de Zeilmodus in of uit (batterij op natuurlijke wijze laten ontladen)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa ou desativa o Modo Navegação (permite que a bateria descarregue naturalmente antes de recarregar)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa ou desativa o Modo Navegação (permite que a bateria descarregue naturalmente antes de recarregar)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает или выключает режим плавания (позволяет батарее естественно разряжаться перед подзарядкой)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapne alebo vypne režim plachtenia (prirodzené vybíjanie batérie pred dobitím)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
