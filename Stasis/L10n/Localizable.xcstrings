    "Temporarily override the charge limit and charge the MacBook to 100 percent, or cancel Top-Up if active.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladelimit vorübergehend aufheben und auf 100% aufladen, oder den Vorgang abbrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anula temporalmente el límite para cargar el MacBook al 100% o cancela si está activo."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Anula temporalmente el límite para cargar el MacBook al 100% o cancela si está activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer temporairement la limite pour recharger le MacBook à 100%, ou annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora temporaneamente il limite per ricaricare il MacBook al 100% o annulla se attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的に制限を解除してMacBookを 100% まで充電するか、アクティブな場合はキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시적으로 제한을 무시하고 MacBook을 100%까지 충전하거나 취소합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdelijk de limiet negeren om tot 100% op te laden, of annuleer als dit actief is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorar temporariamente o limite e carregar o MacBook até 100%, ou cancelar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorar temporariamente o limite e carregar o MacBook até 100%, ou cancelar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временно обойти лимит и зарядить MacBook до 100% или отменить, если активно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dočasne ignorovať limit a nabiť MacBook na 100% alebo zrušiť prebiehajúce nabíjanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začasno premosti omejitev in napolni MacBook do 100% ali prekliči polnjenje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj sınırını geçici olarak yoksayarak MacBook'u 100% şarj edin veya iptal edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm thời bỏ qua giới hạn để sạc MacBook lên 100% hoặc hủy nếu đang sạc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时无视充电限制并将 MacBook 充满至 100%，或在活动时取消充至满电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時略過充電上限並將 MacBook 充滿至 100%，或在啟用時取消充滿電。"
          }
        }
      }
    },
    "Temporarily override the limit and charge to 100 percent (or cancel Top-Up).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
