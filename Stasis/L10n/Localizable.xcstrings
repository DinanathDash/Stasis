    "Show a banner notification with percentage, charging mode, wattage, health, and temperature.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eine Banner-Benachrichtigung mit Prozentzahl, Lademodus, Wattzahl, Zustand und Temperatur an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una notificación con porcentaje, modo de carga, vataje, salud y temperatura."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una notificación con porcentaje, modo de carga, vataje, salud y temperatura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une notification avec pourcentage, mode de recharge, puissance, santé et température."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una notifica con percentuale, modalità di ricarica, wattaggio, salute e temperatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パーセンテージ、充電モード、消費電力、バッテリーの状態、温度を含むバナー通知を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백분율, 충전 모드, 전력량, 상태 및 온도를 표시하는 배너 알림을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont een bannermelding met percentage, oplaadmodus, wattage, conditie en temperatuur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe uma notificação em banner com porcentagem, modo de carga, potência, saúde e temperatura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresenta uma notificação com percentagem, modo de carga, potência, saúde e temperatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает уведомление с процентом заряда, режимом, мощностью, состоянием и температурой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí oznámenie s percentami, režimom nabíjania, výkonom, zdravím a teplotou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaže obvestilo s preostalim odstotkom, načinom polnjenja, močjo, zdravjem in temperaturo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzde, şarj modu, watt, sağlık ve sıcaklık bilgilerini içeren bir bildirim gösterir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị thông báo với tỷ lệ phần trăm, chế độ sạc, công suất, độ chai pin và nhiệt độ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示包含电量百分比、充电模式、功率、电池健康和温度的横幅通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示包含電量百分比、充電模式、功率、電池健康和溫度的橫幅通知。"
          }
        }
      }
    },
