        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약된 배터리 보정 시간입니다. 이렇게 하면 재충전하기 전에 Mac이 %@로 방전됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est le moment de l'étalonnage planifié. Votre Mac se déchargera à %@ avant de se recharger."
          }
        },
        "it": {
          "stringUnit": {
