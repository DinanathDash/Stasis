    "Starts an automated battery calibration cycle (Discharge to 15 percent → Recharge to 100 percent → Rest at 100 percent).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet einen automatischen Batteriekalibrierungszyklus (Entladen auf 15 % → Laden auf 100 % → Ruhen bei 100 %)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia un ciclo automatizado de calibración de batería (Descarga al 15% → Carga al 100% → Reposo al 100%)."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia un ciclo automatizado de calibración de batería (Descarga al 15% → Carga al 100% → Reposo al 100%)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance un cycle automatisé d'étalonnage (Décharge à 15 % → Recharge à 100 % → Repos à 100 %)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia un ciclo di calibrazione automatico (Scarica al 15% → Ricarica al 100% → Riposo al 100%)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動バッテリーキャリブレーションサイクルを開始します（15％まで放電→100％まで充電→100％で静止）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 배터리 보정 사이클을 시작합니다(15%까지 방전 → 100%까지 충전 → 100%에서 대기)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start een geautomatiseerde batterijkalibratiecyclus (ontladen tot 15% → opladen tot 100% → rusten op 100%)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia um ciclo automatizado de calibração (Descarregar até 15% → Recarregar até 100% → Repouso em 100%)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia um ciclo automatizado de calibração (Descarregar até 15% → Recarregar até 100% → Repouso em 100%)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает автоматический цикл калибровки (Разрядка до 15 % → Зарядка до 100 % → Отдых на 100 %)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustí automatický cyklus kalibrácie (Vybite na 15 % → Nabite na 100 % → Pokoj pri 100 %)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začne samodejni cikel umerjanja (Praznjenje do 15 % → Polnjenje do 100 % → Počitek pri 100 %)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik batarya kalibrasyon döngüsünü başlatır (%15'e deşarj → %100'e şarj → %100'de dinlenme)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu chu kỳ hiệu chỉnh pin tự động (Xả xuống 15% → Sạc lên 100% → Nghỉ ở 100%)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动自动电池校准周期（放电至 15% → 充至 100% → 100% 静置）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
