          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dočasne ignoruje limit a nabije na 100 % (alebo zruší dobíjanie)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začasno prezre omejitev in napolni do 100 % (ali prekliče dopolnitev)."
          }
        },
        "tr": {
