    "Forces your MacBook to run on battery power while plugged in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwingt Ihr MacBook, im Netzbetrieb auf Akku zu laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliga a tu MacBook a funcionar con batería mientras está conectado."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliga a tu MacBook a funcionar con batería mientras está conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Force votre MacBook à fonctionner sur batterie en étant branché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forza il MacBook a funzionare a batteria pur essendo collegato al caricatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源アダプタに接続したまま、バッテリー駆動を強制します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원 어댑터가 연결되어 있는 동안 배터리로 작동하도록 강제합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwingt uw MacBook op batterijstroom te werken terwijl de adapter is aangesloten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Força o MacBook a funcionar com a bateria enquanto conectado à tomada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Força o MacBook a funcionar com a bateria enquanto ligado à corrente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заставляет MacBook работать от батареи даже при подключённом адаптере."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vynúti napájanie z batérie aj pri pripojenom napájacom adaptéri."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisili MacBook, da deluje na baterijo, medtem ko je priključen na polnilnik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBook'unuzu prize takılıyken batarya gücüyle çalışmaya zorlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Buộc MacBook chạy bằng pin trong khi cắm nguồn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接通电源时强制 MacBook 使用电池放电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接通電源時強制 MacBook 使用電池放電。"
          }
        }
      }
    },
