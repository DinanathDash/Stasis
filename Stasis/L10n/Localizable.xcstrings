          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyir Modunu etkinleştirir veya devre dışı bırakır (şarj etmeden önce doğal deşarja izin verir)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hoặc tắt chế độ Trôi dạt (cho phép pin xả tự nhiên trước khi sạc lại)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用或停用巡航模式（允许电池在充电前自然耗尽部分电量）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用或停用巡航模式（允許電池在充電前自然耗盡部分電量）。"
          }
        }
      }
    },
