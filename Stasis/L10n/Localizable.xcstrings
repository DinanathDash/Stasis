    "Immediately stops an active battery calibration cycle and restores standard charging controls.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt den aktiven Batteriekalibrierungszyklus sofort und stellt die standardmäßige Ladekontrolle wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene inmediatamente el ciclo de calibración activo y restaura los controles estándar de carga."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene inmediatamente el ciclo de calibración activo y restaura los controles estándar de carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête immédiatement le cycle d'étalonnage actif et restaure les contrôles de charge standard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe immediatamente un ciclo di calibrazione attivo e ripristina i controlli di ricarica standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中のバッテリーキャリブレーションを即座に停止し、通常時の充電制御を復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 배터리 보정 사이클을 즉시 중지하고 표준 충전 제어를 복원합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt onmiddellijk een actieve kalibratiecyclus en herstelt standaard oplaadbediening."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe imediatamente o ciclo de calibração ativo e restaura os controles de carregamento padrão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe imediatamente o ciclo de calibração ativo e restaura os controlos de carregamento padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немедленно останавливает активный цикл калибровки и восстанавливает стандартное управление зарядкой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Okamžite zastaví aktívny cyklus kalibrácie a obnoví štandardné ovládanie nabíjania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Takoj ustavi aktivni cikel umerjanja in obnovi standardne kontrole polnjenja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin bir kalibrasyon döngüsünü hemen durdurur ve standart şarj kontrollerini geri yükler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng ngay chu kỳ hiệu chỉnh pin đang chạy và khôi phục điều khiển sạc tiêu chuẩn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即停止正在进行的电池校准，并恢复标准充电控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即停止正在進行的電池校準，並恢復標準充電控制。"
          }
        }
      }
    },
