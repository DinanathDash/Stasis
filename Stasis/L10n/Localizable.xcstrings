    "All commands support parameters and toggles. Click any command to copy its URL or test it live.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Befehle unterstützen Parameter und Umschalter. Klicken Sie auf einen Befehl, um seine URL zu kopieren oder live zu testen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los comandos admiten parámetros y alternancias. Haz clic en cualquier comando para copiar su URL o probarlo en vivo."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los comandos admiten parámetros y alternancias. Haz clic en cualquier comando para copiar su URL o probarlo en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les commandes prennent en charge des paramètres et des bascules. Cliquez sur une commande pour copier son URL ou la tester en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i comandi supportano parametri e interruttori. Fai clic su un comando per copiare il suo URL o testarlo dal vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのコマンドはパラメータとトグルをサポートしています。コマンドをクリックしてURLをコピーしたり、実際にテストしたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 명령은 매개변수와 토글을 지원합니다. 명령을 클릭하여 URL을 복사하거나 실시간으로 테스트하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle opdrachten ondersteunen parameters en schakelaars. Klik op een opdracht om de URL te kopiëren of live te testen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os comandos suportam parâmetros e alternadores. Clique em qualquer comando para copiar seu URL ou testá-lo ao vivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os comandos suportam parâmetros e alternadores. Clique em qualquer comando para copiar o seu URL ou testá-lo em tempo real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все команды поддерживают параметры и переключатели. Нажмите на любую команду, чтобы скопировать её URL или проверить в работе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky príkazy podporujú parametre a prepínače. Kliknutím na ľubovoľný príkaz skopírujete jeho adresu URL alebo ho otestujete naživo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi ukazi podpirajo parametre in preklopnike. Kliknite na kateri koli ukaz, da kopirate njegov URL ali ga preizkusite v živo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm komutlar parametreleri ve açma/kapatmayı destekler. URL'sini kopyalamak veya canlı test etmek için herhangi bir komuta tıklayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả các lệnh đều hỗ trợ tham số và chuyển đổi. Nhấp vào bất kỳ lệnh nào để sao chép URL hoặc kiểm tra trực tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有命令均支持参数和开关。点击任何命令可复制其 URL 或实时测试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有命令均支援參數和開關。點擊任何命令可複製其 URL 或即時測試。"
          }
        }
      }
    },
    "All preferences have been successfully restored to their defaults. The app will now restart.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einstellungen wurden erfolgreich auf ihre Standardeinstellungen zurückgesetzt. Die App wird nun neu gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las preferencias se han restaurado exitosamente a sus valores predeterminados. La aplicación ahora se reiniciará."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las preferencias se han restaurado exitosamente a sus valores predeterminados. La aplicación ahora se reiniciará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les préférences ont été restaurées avec succès à leurs valeurs par défaut. L'application va maintenant redémarrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le preferenze sono state ripristinate con successo ai valori predefiniti. L'app verrà ora riavviata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定がデフォルトに正常に復元されました。アプリが再起動されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기본 설정이 기본값으로 성공적으로 복원되었습니다. 이제 앱이 다시 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle voorkeuren zijn met succes hersteld naar hun standaardwaarden. De app zal nu opnieuw opstarten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as definições foram repostas para os valores predefinidos. A aplicação vai ser reiniciada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as definições foram repostas para os valores predefinidos. A aplicação vai ser reiniciada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все настройки были успешно восстановлены до значений по умолчанию. Приложение будет перезапущено."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky predvoľby boli úspešne obnovené na predvolené hodnoty. Aplikácia sa teraz reštartuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse nastavitve so bile uspešno ponastavljene na privzete vrednosti. Aplikacija se bo zdaj znova zagnala."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm tercihler başarıyla varsayılan değerlerine geri yüklendi. Uygulama şimdi yeniden başlatılacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả các tùy chọn đã được khôi phục thành công về mặc định. Ứng dụng bây giờ sẽ khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有偏好设置均已恢复为默认值。应用现在将重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有首選項已成功恢復為預設值。該應用程式現在將重新啟動。"
          }
        }
      }
    },
